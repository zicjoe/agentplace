{
  "name": "@agent-place/auth",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require(\\'node:fs\\').rmSync(\\'dist\\',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "migrate": "pnpm build && node --env-file-if-exists=../../.env dist/migrate.js"
  },
  "dependencies": {
    "@agent-place/db": "workspace:*",
    "better-auth": "1.7.14",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
