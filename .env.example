# AgentPlace v0.3.0 local-development defaults. Never commit real credentials.
AGENT_PLACE_ENV=development
LOG_LEVEL=info
TRACE_HEADER=x-agent-place-trace-id

# PostgreSQL — use a local PostgreSQL URL. If testing against Railway from your PC, prefer
# `railway connect postgres --tunnel-only` and use the printed local tunnel connection details.
# In the deployed Railway API service, reference the Postgres service's private DATABASE_URL.
DATABASE_URL=postgresql://agent_place:agent_place@localhost:5432/agent_place
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Redis is not used by Milestone 2 yet; retained for later durable-job infrastructure.
REDIS_URL=redis://localhost:6379

# Financial execution remains disabled on Mainnet in Milestone 2.
TESTNET_EXECUTION_ENABLED=true
MAINNET_EXECUTION_ENABLED=false
MAINNET_AUTONOMY_ENABLED=false

# AgentPlace API.
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Better Auth runs inside the AgentPlace API and stores its own tables in the PostgreSQL auth schema.
# Generate a real secret locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# IMPORTANT: this is the public WEB origin because /api/auth is proxied through the web origin.
BETTER_AUTH_URL=http://localhost:5173
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIWE_DOMAIN=localhost

# Optional Google OAuth. Wallet sign-in still works if these are blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser-visible configuration. VITE_* values must never contain secrets.
# Blank API/Auth base URLs mean same-origin /api, which Vite proxies locally and Vercel proxies in production.
VITE_AGENT_PLACE_API_BASE_URL=
VITE_AGENT_PLACE_AUTH_BASE_URL=
VITE_AGENT_PLACE_DATA_MODE=api
VITE_AGENT_PLACE_ENABLE_DEMO_CONTROLS=false
# Guest-only temporary browser state; authenticated conversations are never stored here as authoritative data.
VITE_AGENT_PLACE_PERSIST_FIXTURES=true

# Vercel server-side variable only (NOT VITE_*): public Railway API origin used by the same-origin proxy.
# Example: https://agentplace-api-production.up.railway.app
AGENT_PLACE_API_ORIGIN=

# RPCs are intentionally blank. Milestone 2 performs no blockchain execution.
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
BNB_TESTNET_RPC_URL=
BNB_MAINNET_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=
