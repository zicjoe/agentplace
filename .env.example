# AgentPlace v0.13.0 local-development defaults. Never commit real credentials.
AGENT_PLACE_ENV=development
LOG_LEVEL=info
TRACE_HEADER=x-agent-place-trace-id

# PostgreSQL — use a local PostgreSQL URL. If testing against Railway from your PC, prefer
# `railway connect postgres --tunnel-only` and use the printed local tunnel connection details.
# In the deployed Railway API service, reference the Postgres service's private DATABASE_URL.
DATABASE_URL=postgresql://agent_place:agent_place@localhost:5432/agent_place
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Redis is not used by Milestone 2 yet; retained for later durable-job infrastructure.
REDIS_URL=redis://localhost:6379

# M10 keeps M9 exact user-signed Connected Wallet execution fail-closed by default while adding read-only settlement verification.
# M12 does not widen financial execution. Keep Mainnet execution and autonomy disabled unless a separately approved execution-path readiness decision changes them.
TESTNET_EXECUTION_ENABLED=true
MAINNET_EXECUTION_ENABLED=false
MAINNET_AUTONOMY_ENABLED=false

# AgentPlace API.
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Better Auth runs inside the AgentPlace API and stores its own tables in the PostgreSQL auth schema.
# Generate a real secret locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# IMPORTANT: this is the public WEB origin because /api/auth is proxied through the web origin.
BETTER_AUTH_URL=http://localhost:5173
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SIWE_DOMAIN=localhost

# Optional Google OAuth. Wallet sign-in still works if these are blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser-visible configuration. VITE_* values must never contain secrets.
# Blank API/Auth base URLs mean same-origin /api, which Vite proxies locally and Vercel proxies in production.
VITE_AGENT_PLACE_API_BASE_URL=
VITE_AGENT_PLACE_AUTH_BASE_URL=
VITE_AGENT_PLACE_DATA_MODE=api
VITE_AGENT_PLACE_ENABLE_DEMO_CONTROLS=false
# Guest-only temporary browser state; authenticated conversations are never stored here as authoritative data.
VITE_AGENT_PLACE_PERSIST_FIXTURES=true

# Vercel server-side variable only (NOT VITE_*): public Railway API origin used by the same-origin proxy.
# Example: https://agentplace-api-production.up.railway.app
AGENT_PLACE_API_ORIGIN=

# Server-side RPCs support M9 pre-sign inspection and deterministic transaction observation. Keep authenticated RPC URLs out of VITE_* variables.
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
BNB_TESTNET_RPC_URL=
BNB_MAINNET_RPC_URL=

# M10 settlement verification is read-only and uses zero LLM polling. Optional secondary RPCs improve independent evidence cross-checking.
VERIFICATION_OBSERVER_POLL_MS=5000
VERIFICATION_RETRY_BASE_MS=15000
VERIFICATION_MAX_RETRY_MS=300000
AGENTPLACE_EVM_RPC_42161_SECONDARY=
AGENTPLACE_EVM_RPC_8453_SECONDARY=
AGENTPLACE_EVM_RPC_1_SECONDARY=

SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# Milestone 4 — Intelligence Foundation (server-side only; never expose in VITE_* variables)
AGENTPLACE_DEFAULT_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_BALANCED=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-3.8-pro
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_BALANCED=gpt-6-sol
OPENAI_MODEL_REASONING=gpt-6-astra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-sonnet-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
ANTHROPIC_MODEL_REASONING=claude-fable-5
AI_MODEL_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=2500
AI_MAX_CALLS_PER_TASK=3
AI_DAILY_COST_LIMIT_USD=0
AI_WORKER_POLL_MS=1500
# Optional cost telemetry. Keep 0 unless you intentionally configure current provider rates.
GEMINI_INPUT_USD_PER_MILLION=0
GEMINI_OUTPUT_USD_PER_MILLION=0
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
ANTHROPIC_INPUT_USD_PER_MILLION=0
ANTHROPIC_OUTPUT_USD_PER_MILLION=0

# Milestone 5B.1 — Core Crypto Intelligence Fabric (server-side only; never expose in VITE_* variables)
# Free/no-key adapters are available for DEX Screener, DefiLlama and supported Blockscout explorers.
INTELLIGENCE_PROVIDER_TIMEOUT_MS=20000
COINGECKO_DEMO_API_KEY=
COINGECKO_API_KEY=
NANSEN_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Optional static bearer-token override; normally AgentPlace mints/refreshes it from app key + secret.
GOPLUS_ACCESS_TOKEN=
BIRDEYE_API_KEY=
BUBBLEMAPS_API_KEY=
# Zero-cost / free-tier intelligence hardening (server-side Worker only)
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
THEGRAPH_API_KEY=
THEGRAPH_UNISWAP_V3_ARBITRUM_SUBGRAPH_ID=
# Chainbase was evaluated for M5B.1 but is not routed by default because Data Cloud requires schema/query-specific IDs.
CHAINBASE_API_KEY=

# Milestone 5B.2.1 — Telegraph Protocol testnet discovery (server-side only)
# Defaults point to Telegraph's documented public testnet node. No variable is required for the default path.
# These are non-secret operational overrides only; do not place payment keys/private keys in AgentPlace for M5B.2.1.
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
TELEGRAPH_DISPATCHER_URL=https://devnode.telegraphprotocol.com/miner-dispatcher
TELEGRAPH_TIMEOUT_MS=10000
TELEGRAPH_MAX_RESPONSE_BYTES=4194304

# Milestone 5B.2.3 — Telegraph direct inference + bounded x402 service payments (Railway Worker only)
# IMPORTANT: TELEGRAPH_EVM_PRIVATE_KEY is a dedicated low-funded AgentPlace SERVICE-PAYMENT key.
# Never reuse a user wallet, Agent Account, production treasury, or provider credential. Never expose it to VITE_*.
# Keep disabled until the dedicated Base Sepolia service wallet is created and funded with test USDC.
TELEGRAPH_SERVICE_PAYMENT_ENABLED=false
TELEGRAPH_EVM_PRIVATE_KEY=
# These can only tighten the hard code limits: $0.02/call, $0.10/job, 10 paid calls/job.
TELEGRAPH_X402_MAX_CALL_USDC=0.02
TELEGRAPH_X402_MAX_JOB_USDC=0.10
TELEGRAPH_X402_MAX_CALLS_PER_JOB=10
# Free discovery is cached so Router planning does not repeatedly hit Telegraph metadata endpoints.
TELEGRAPH_DISCOVERY_CACHE_MS=120000

# Milestone 5B.2.4 — live acceptance controls. Keep disarmed during normal runtime.
# The paid runner also requires an exact implementation ID from telegraph:acceptance:plan.
TELEGRAPH_LIVE_ACCEPTANCE_ENABLED=false
TELEGRAPH_LIVE_ACCEPTANCE_CONFIRM=
TELEGRAPH_ACCEPTANCE_IMPLEMENTATION_ID=
TELEGRAPH_ACCEPTANCE_SUBJECT_KIND=token
TELEGRAPH_ACCEPTANCE_QUERY=
TELEGRAPH_ACCEPTANCE_NETWORK=
TELEGRAPH_ACCEPTANCE_ADDRESS=

# M8/M9 — live quote, pre-sign inspection, and transaction observation
# LI.FI works without a key at limited development rate; set a key only if you choose to provision one.
LIFI_API_BASE_URL=https://li.quest/v1
# LIFI_API_KEY=
# Optional chain-ID RPC overrides. M9 uses these for eth_estimateGas and read-only transaction observation; never for user signing.
# AGENTPLACE_EVM_RPC_42161=
# AGENTPLACE_EVM_RPC_42161_SECONDARY=
# AGENTPLACE_EVM_RPC_8453=
# AGENTPLACE_EVM_RPC_8453_SECONDARY=
EXECUTION_OBSERVER_POLL_MS=4000
# If a wallet-returned hash cannot be found on configured RPCs for this long, mark UNKNOWN and never auto-resubmit.
EXECUTION_UNKNOWN_AFTER_MS=600000

# Milestone 11 — Routines + Background Work (Railway Scheduler; server-side only)
ROUTINE_SCHEDULER_POLL_MS=5000
ROUTINE_SCHEDULER_BATCH_SIZE=25
# Default recurring service-spend guardrails for newly created Routine drafts.
ROUTINE_DEFAULT_SERVICE_BUDGET_USD=5
ROUTINE_DEFAULT_MAX_COST_PER_RUN_USD=1

# Milestone 13 — Billing + Security Completion (server-side only)
# Service-balance funding is testnet-only and disabled by default. This never enables Mainnet execution/autonomy.
BILLING_TESTNET_TOPUP_ENABLED=false
# Canonical/test token contract used for Arbitrum Sepolia USDC-style service top-ups. Configure deliberately before acceptance.
BILLING_TESTNET_USDC_ADDRESS=
# Public treasury address that receives testnet service payments. Never place a private key here.
BILLING_SERVICE_TREASURY_ADDRESS=
# Optional dedicated read-only RPC override for top-up receipt verification; AGENTPLACE_EVM_RPC_421614 is also accepted.
ARBITRUM_SEPOLIA_RPC_URL=
