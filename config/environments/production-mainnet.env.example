# AgentPlace production-mainnet safety defaults for v0.16.0 / M13.
# M13 billing/security completion does not enable Mainnet financial execution or autonomy. User-signed execution still requires deliberate pre-existing gates.
AGENT_PLACE_ENV=production-mainnet
TESTNET_EXECUTION_ENABLED=true
MAINNET_EXECUTION_ENABLED=false
# M13 does not enable autonomous Mainnet execution. Keep this false.
MAINNET_AUTONOMY_ENABLED=false
# Deterministic RPC observer cadence; no LLM calls are used for transaction polling.
EXECUTION_OBSERVER_POLL_MS=4000
# If a wallet-returned hash cannot be found on configured RPCs for this long, mark UNKNOWN and never auto-resubmit.
EXECUTION_UNKNOWN_AFTER_MS=600000

# M10 deterministic settlement verification. Read-only; no LLM calls and no signer.
VERIFICATION_OBSERVER_POLL_MS=5000
VERIFICATION_RETRY_BASE_MS=15000
VERIFICATION_MAX_RETRY_MS=300000
# Optional distinct RPC for independent cross-checking of Arbitrum evidence.
AGENTPLACE_EVM_RPC_42161_SECONDARY=

# M11 durable background Scheduler. No wallet signer or proof signer is required.
ROUTINE_SCHEDULER_POLL_MS=5000
ROUTINE_SCHEDULER_BATCH_SIZE=25
ROUTINE_DEFAULT_SERVICE_BUDGET_USD=5
ROUTINE_DEFAULT_MAX_COST_PER_RUN_USD=1

# M13 service-balance funding remains testnet-only and is disabled by default in production-mainnet.
BILLING_TESTNET_TOPUP_ENABLED=false
BILLING_TESTNET_USDC_ADDRESS=
BILLING_SERVICE_TREASURY_ADDRESS=
ARBITRUM_SEPOLIA_RPC_URL=
