{
  "name": "@agent-place/api",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@agent-place/auth": "workspace:*",
    "@agent-place/context": "workspace:*",
    "@agent-place/db": "workspace:*",
    "@agent-place/shared": "workspace:*",
    "@agent-place/workers": "workspace:*",
    "@agent-place/jobs": "workspace:*",
    "@agent-place/capabilities": "workspace:*",
    "@agent-place/models": "workspace:*",
    "@agent-place/router": "workspace:*",
    "@agent-place/intelligence": "workspace:*",
    "@agent-place/wallets": "workspace:*",
    "@agent-place/authority": "workspace:*",
    "@agent-place/execution": "workspace:*",
    "@agent-place/risk": "workspace:*",
    "@agent-place/verification": "workspace:*",
    "@agent-place/routines": "workspace:*",
    "@agent-place/notifications": "workspace:*",
    "@agent-place/marketplace": "workspace:*",
    "@agent-place/creator-sdk": "workspace:*",
    "@agent-place/billing": "workspace:*",
    "@agent-place/security": "workspace:*"
  }
}
